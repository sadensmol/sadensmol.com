# Copy to .env (gitignored) for local runs; `make` loads it.
# CI takes the same values from the GitHub repo settings instead.

# Buttondown username; renders the email subscribe form. CI: Actions variable BUTTONDOWN_USERNAME.
HUGO_PARAMS_BUTTONDOWN_USERNAME=

# Buttondown API key (email_access + sending_access: write); only the send script uses it. CI: Actions secret BUTTONDOWN_API_KEY.
BUTTONDOWN_API_KEY=
